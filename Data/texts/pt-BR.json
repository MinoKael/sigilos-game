    "glifos": {
      "intro": "Os Glifos são símbolos de runa, e cada um quer dizer uma coisa em todo o jogo — nas runas, nos efeitos e nos textos. Gebo (×) é atordoar: onde aparecer, é {0}.",
      "conjunto": "Conjunto: {0}"
    },
    "efeitos": {
      "intro": "Efeitos duram turnos de quem os recebe. Os negativos passam pela Resistência do alvo menos a Precisão de quem lança (mínimo de {0}); a Imunidade barra todos. Na luta, o botão Efeitos mostra o que está sobre cada unidade.",
      "negativo": "negativo",
      "positivo": "positivo"
    },
    "runas": {
      "espacos": { "titulo": "Espaços", "texto": "Seis espaços em círculo. 1, 3 e 5 dão sempre Ataque, Defesa e Vida fixos; o 2 pode ter Velocidade, o 4 Crítico ou Dano crítico, o 6 Resistência ou Precisão, e os três podem ter Vida, Ataque ou Defesa, fixos ou em porcentagem sobre a base." },
      "estrelas": { "titulo": "Estrelas e raridade", "texto": "De 1 a {0} estrelas: decidem o tamanho de todos os números. A cor é a raridade, quantos subatributos a runa tem: Normal 0, Mágica 1, Rara 2, Heroica 3, Lendária 4. Às vezes vem um atributo nativo, que nunca cresce." },
      "melhora": { "titulo": "Melhora", "texto": "Essência melhora de +0 a +{0} (a mesma do nível e do Despertar), e a melhora nunca falha. Em +3, +6, +9 e +12 entra um subatributo novo (até {1}) ou um deles cresce; em +15 o principal dá o salto final." },
      "conjuntos": { "titulo": "Conjuntos", "texto": "Duas ou quatro runas do mesmo conjunto dão o bônus dele. Com 6 espaços cabem um de 4 e um de 2, ou três de 2 (três iguais valem três vezes). Cada conjunto tem o seu Glifo." },
      "afiar": { "titulo": "Pedra de Afiar", "texto": "Soma um bônus a um subatributo de Vida, Ataque, Defesa ou Velocidade do mesmo tipo da pedra. Uma pedra nova troca o bônus antigo." },
      "gema": { "titulo": "Gema Encantada", "texto": "Troca um subatributo de uma runa +{0} pelo da gema. Só um subatributo por runa pode ser encantado." },
      "onde": { "titulo": "Onde conseguir", "texto": "A Campanha solta runas de até {0} estrelas (sempre na primeira vitória, {1} de chance depois). As Masmorras soltam as de 5 e 6 estrelas e as pedras." },
