      "level": { "title": "Nível", "text": "Cada estrela tem o seu nível máximo: {0} no 3★, até {1} no 6★. Vitórias dão experiência à equipe que lutou; em Monstros, cada Essência infundida vale {2} de experiência. A mesma Essência paga a evolução, o Despertar e a melhora de runas." },
      "stars": { "title": "Estrelas e evolução", "text": "As estrelas naturais são só o começo: todo monstro chega a {0}★. No nível máximo, pague Essência e Fragmentos para ganhar uma estrela; o máximo sobe 5. De 3★ para 4★: {1} de Essência e {2} Fragmentos; de 4★ para 5★: {3} e {4}; de 5★ para 6★: {5} e {6}." },
      "skills": { "title": "Habilidades e cópias", "text": "Cada habilidade tem níveis: mais dano, recuperação ou chance de efeito, ou menos recarga. Fundir uma cópia repetida sobe uma habilidade sorteada em um nível. As cópias que sobram podem ser liberadas em Fragmentos, que pagam a evolução. Alguns monstros têm uma Passiva, que age sozinha." },
      "awaken": { "title": "Despertar", "text": "Pague Essência ({0}, {1} ou {2}, pelas estrelas naturais) e o monstro ganha nome próprio, desenho novo, estrelas roxas, +{3} de Vida e +{4} de Ataque e Defesa, e mais um bônus: uma habilidade nova (quase sempre 3★), uma habilidade mais forte (quase sempre 4★) ou um atributo (quase sempre 5★: {5}, {6}, {7} ou {8})." },
      "sanctuary": { "title": "Santuário e símbolos", "text": "Todo botão é um símbolo: passe o mouse para ver o nome. No centro do Santuário, o círculo de canalização junta Essência, Ouro e Mana enquanto você está fora, até {0} horas; toque nele para coletar. As estrelas em volta são os seus atalhos: a pena deixa escolher quais. O Mapa leva à Campanha e às Masmorras; a Bolsa guarda monstros, runas, equipes, a Invocação e os livros." }
    },
    "combat": {
      "impetus": { "title": "Ímpeto", "text": "Cada unidade tem uma barra de {0} que enche em proporção à Velocidade; quem chega a 100% age. Empurrar ou atrasar a barra muda a ordem — a faixa \"Próximos\" mostra quem vem." },
      "fight": { "title": "A luta", "text": "Até {0} monstros contra até {2} inimigos por onda, em até {1} ondas. Passar de {3} rodadas é derrota." },
      "damage": { "title": "Dano", "text": "Ataque × multiplicador da habilidade × {0} / ({0} + Defesa do alvo). Defesa {0} corta o dano pela metade." },
      "crit": { "title": "Crítico", "text": "O golpe crítico multiplica o dano por 1 + Dano crítico. Todo monstro começa com 15% de Crítico e 50% de Dano crítico." },
      "resistance": { "title": "Resistência e Precisão", "text": "Todo efeito negativo pode ser barrado: a chance é a Resistência do alvo menos a Precisão de quem lança, nunca abaixo de {0}." },
      "leader": { "title": "Líder", "text": "A primeira da equipe aplica a Liderança dela a todos. A porcentagem é sobre o atributo de base, nunca sobre o que veio das runas." },
      "auto": { "title": "Automático e Resolver", "text": "O automático usa sozinho a habilidade pronta mais forte. Fases e andares já vencidos ganham a Batalha automática: você escolhe quantas lutas seguidas ({0} de início), cada uma no tempo que levaria no automático em 2×. Para quando a Mana acaba ou o inventário de runas enche." },
      "elements": "Elementos",
      "elements_text": "Com vantagem o dano sobe {0}; com desvantagem, cai {1}. O automático mira primeiro em quem ele vence.",
      "wins": "{0} vence {1}"
    },
    "stats": {
      "intro": "Os oito atributos de todo monstro. Cada um tem o seu Glifo: o do conjunto de runas que o aumenta."
    },
    "glyphs": {
      "intro": "Glifos são símbolos de runa: cada conjunto tem o seu, e o atributo que ele aumenta usa o mesmo (Tiwaz é Ataque, na runa e na ficha). Os efeitos de batalha têm símbolos próprios, na aba Efeitos.",
      "set": "Conjunto: {0}"
    },
    "effects": {
      "intro": "Efeitos duram turnos de quem os recebe. Os negativos passam pela Resistência do alvo menos a Precisão de quem lança (mínimo de {0}); a Imunidade barra todos. Na luta, o botão Efeitos mostra o que está sobre cada unidade.",
      "negative": "negativo",
      "positive": "positivo"
    },
    "runes": {
      "slots": { "title": "Espaços", "text": "Seis espaços em círculo. 1, 3 e 5 dão sempre Ataque, Defesa e Vida fixos; o 2 pode ter Velocidade, o 4 Crítico ou Dano crítico, o 6 Resistência ou Precisão, e os três podem ter Vida, Ataque ou Defesa, fixos ou em porcentagem sobre a base." },
      "stars": { "title": "Estrelas e raridade", "text": "De 1 a {0} estrelas: decidem o tamanho de todos os números. A cor é a raridade, quantos subatributos a runa tem: Normal 0, Mágica 1, Rara 2, Heroica 3, Lendária 4. Às vezes vem um atributo nativo, que nunca cresce." },
      "upgrade": { "title": "Melhora", "text": "Essência melhora de +0 a +{0} (a mesma do nível e do Despertar), e a melhora nunca falha. Em +3, +6, +9 e +12 entra um subatributo novo (até {1}) ou um deles cresce; em +15 o principal dá o salto final." },
      "sets": { "title": "Conjuntos", "text": "Duas ou quatro runas do mesmo conjunto dão o bônus dele. Com 6 espaços cabem um de 4 e um de 2, ou três de 2 (três iguais valem três vezes). Cada conjunto tem o seu Glifo." },
      "grind": { "title": "Pedra de Afiar", "text": "Soma um bônus a um subatributo de Vida, Ataque, Defesa ou Velocidade do mesmo tipo da pedra. Uma pedra nova troca o bônus antigo." },
      "gem": { "title": "Gema Encantada", "text": "Troca um subatributo de uma runa +{0} pelo da gema. Só um subatributo por runa pode ser encantado." },
      "where": { "title": "Onde conseguir", "text": "A Campanha solta runas de até {0} estrelas (sempre na primeira vitória, {1} de chance depois). As Masmorras soltam as de 5 e 6 estrelas e as pedras." },
      "grimoire": { "title": "Tabelas", "text": "Os números de cada estrela, os custos de melhora e as faixas das pedras estão no Grimório." }
