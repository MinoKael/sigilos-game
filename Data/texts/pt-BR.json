  "compendium": {
    "tab": {
      "basic": "Como jogar",
      "combat": "Combate",
      "stats": "Atributos",
      "planets": "Sigilos",
      "effects": "Efeitos",
      "runes": "Sigilos"
    },
    "basic": {
      "campaign": { "title": "Campanha", "text": "50 fases em três regiões, com até 3 ondas; cada vitória custa Mana. A primeira vitória dá Transmutações Alquímicas e sempre um sigilo; as seguintes dão Essência e chance de sigilo. A Campanha apresenta o jogo aos poucos: cada parte do Observatório abre numa fase. Ela solta sigilos de até {0} estrelas; vencer a fase 50 pede cerca de nível 20 com sigilos, ou 6★ nível 40 sem." },
      "dungeons": { "title": "Masmorras", "text": "Cada Masmorra tem 5 andares, um elemento na maior parte dos inimigos, e solta o que a Campanha não solta: sigilos Raros ou melhores de quatro conjuntos certos, ou Pedras de Afiar e Gemas (o Santuário). Cada andar mostra a chance de cada estrela e raridade, e quanto mais fundo, maior o sigilo: 2 e 3 estrelas no andar 1, só 6 estrelas no andar 5. O andar 1 é igual de difícil em todas, e assim por diante, tão difícil quanto o que paga. Elas abrem durante a Campanha: Golem (Vento), Serpe (Fogo) e Santuário (Água); leve o elemento com vantagem. Cada vitória custa Mana e pode soltar também uma Transmutação Alquímica; a primeira vitória em cada andar dá Ouro." },
      "exploration": { "title": "Exploração Estelar", "text": "Um percurso pelas 88 constelações do céu: as Boreais, as Equatoriais (com as 12 do zodíaco) e as Austrais, uma depois da outra. Cada constelação tem a sua Influência, uma mecânica que vale a luta inteira (leia antes e monte a equipe para ela), e muitas vezes o desafio são as habilidades do guardião, uma transmutação desperta com as habilidades no máximo. A cada mês, uma de {0} Explorações traz os desafios, em rodízio, e no dia 1 o percurso recomeça do zero. A recompensa de cada constelação é sempre a mesma e volta todo mês, na primeira vitória dela: Essência, Ouro, Transmutações e, nos marcos, Núcleos de Infusão e Transmutações especiais. A luta não custa Mana, tem uma equipe própria e é feita para o manual." },
      "mana": { "title": "Mana e nível da conta", "text": "Toda vitória custa Mana; a derrota não custa nada, mas para lutar é preciso ter a Mana da vitória. A canalização recarrega {2} por hora até o dobro da Mana máxima, que é {0} no nível 1 da conta e {1} no nível {3}, o último. Toda vitória dá experiência também à conta, e cada nível enche a Mana. No nível {3}, um terço da experiência vira Essência." },
      "gold": { "title": "Ouro e Loja", "text": "O Ouro é a moeda rara: vem da canalização, de cada nível da conta (+{0}) e da primeira vitória em cada andar de Masmorra. Na Loja, compra Mana (pode passar do máximo) ou Transmutações." },
      "summon": { "title": "Transmutação", "text": "A Transmutação Alquímica cria homúnculos. Cada transmutação é uma cópia nova, nas estrelas naturais e no nível 1. A Alquímica tira Fogo, Água e Vento, com a garantia de 5★ sempre à vista e {0} de chance de um homúnculo de Luz ou Trevas (repartida por igual entre os de 3★ que podem sair); a de Luz e Trevas, só Luz e Trevas; a Lendária, só 4★ e 5★. As duas especiais vêm dos marcos do jogo. A primeira 5★ da conta é garantida, e Fragmentos trocam por uma 4★ escolhida." },
      "monsters": { "title": "Homúnculos e Baú", "text": "A coleção começa com {0} vagas e cresce na Loja, com a Expansão de Coleção, até {2}; o Baú guarda o que passar disso, sem limite. Homúnculo no Baú não luta, mas guarda os sigilos dele: eles não ocupam as {1} vagas do inventário de sigilos. Bloqueie um homúnculo ou um sigilo (o cadeado) para nunca soltar, fundir ou vender por engano; desbloqueie para fazer isso." },
      "teams": { "title": "Equipes", "text": "A equipe, de até {0} homúnculos, se monta na preparação de cada luta (o Lutar). A Campanha, cada Masmorra e a Exploração Estelar guardam a última usada nelas. A primeira é a Líder." },
      "level": { "title": "Nível", "text": "Cada estrela tem o seu nível máximo: {0} no 3★, até {1} no 6★. Vitórias dão experiência à equipe que lutou; em Homúnculos, cada Essência infundida vale {2} de experiência. A mesma Essência paga a evolução, o Despertar e a melhora de sigilos." },
      "stars": { "title": "Estrelas e evolução", "text": "As estrelas naturais são só o começo: todo homúnculo chega a {0}★. No nível máximo, pague Fragmentos para ganhar uma estrela: o homúnculo mantém o nível, os atributos sobem para os da estrela nova e o máximo sobe 5. De 3★ para 4★: {1} Fragmentos; de 4★ para 5★: {2}; de 5★ para 6★: {3}." },
      "skills": { "title": "Habilidades e cópias", "text": "Cada habilidade tem níveis: mais dano, recuperação ou chance de efeito, ou menos recarga. Fundir uma cópia da mesma família (de qualquer elemento) sobe uma habilidade sorteada em um nível. As cópias que sobram podem ser soltas em troca de Fragmentos, que pagam a evolução. Alguns homúnculos têm uma Passiva, que age sozinha." },
      "awaken": { "title": "Despertar", "text": "Pague Essência ({0}, {1} ou {2}, pelas estrelas naturais) e o homúnculo ganha nome próprio, uma aura viva com o anel do elemento, estrelas roxas e mais Vida, Ataque e Defesa (cada homúnculo tem os seus atributos despertos: veja no Grimório), e mais um bônus: uma habilidade nova (quase sempre 3★), uma habilidade mais forte (quase sempre 4★) ou um atributo (quase sempre 5★: {3}, {4}, {5} ou {6})." },
      "sanctuary": { "title": "Observatório e controles", "text": "O Observatório é a tela de início. A Canalização junta Essência, Ouro e Mana enquanto você está fora, até {0} horas: colete lá. Batalha leva à Campanha e às Masmorras; a barra de baixo leva a Homúnculos, Sigilos, Loja e aos livros. Toque numa moeda, numa recompensa ou numa palavra que não conhece para ver o que é; segure um homúnculo para ver o resumo dele." }
    },
    "combat": {
      "impetus": { "title": "Ímpeto", "text": "Cada unidade tem uma barra de {0} que enche em proporção à Velocidade; quem chega a 100% age. Empurrar ou atrasar a barra muda a ordem — a faixa \"Próximos\" mostra quem vem." },
      "fight": { "title": "A luta", "text": "Até {0} homúnculos contra até {2} inimigos por onda, em até {1} ondas. Passar de {3} rodadas é derrota." },
      "damage": { "title": "Dano", "text": "Ataque × multiplicador da habilidade × {0} / ({0} + Defesa do alvo). Defesa {0} corta o dano pela metade." },
      "crit": { "title": "Crítico", "text": "O golpe crítico multiplica o dano por 1 + Dano crítico. Todo homúnculo começa com 15% de Crítico e 50% de Dano crítico." },
      "resistance": { "title": "Resistência e Precisão", "text": "Todo efeito negativo pode ser barrado: a chance é a Resistência do alvo menos a Precisão de quem lança, nunca abaixo de {0}." },
      "leader": { "title": "Líder", "text": "A primeira da equipe aplica a Liderança dela a todos. A porcentagem é sobre o atributo de base, nunca sobre o que veio dos sigilos." },
      "auto": { "title": "Automático e Batalha automática", "text": "O automático usa sozinho a habilidade pronta mais forte. Fases e andares já vencidos ganham a Batalha automática: você escolhe quantas lutas seguidas ({0} de início), cada uma no tempo que levaria no automático em 2×. Ela segue enquanto você faz outras coisas (cuidar dos sigilos, subir homúnculos); o aviso no alto da tela mostra o andamento e abre a janela dela. Para quando você aperta Parar, quando a Mana acaba ou quando o inventário de sigilos enche. Toque num inimigo durante a luta para marcá-lo: o automático ataca ele enquanto puder (segure o inimigo para ver o resumo). Numa luta com chefe, a pausa tem \"Focar o chefe no automático\": ligado, a equipe inteira ataca o chefe sempre que pode." },
      "elements": "Elementos",
      "elements_text": "Com vantagem o dano sobe {0}; com desvantagem, cai {1}. O automático mira primeiro em quem ele vence.",
      "wins": "{0} vence {1}"
    },
    "stats": {
      "intro": "Os oito atributos de todo homúnculo. Cada um tem o seu Sigilo: o do conjunto de sigilos que o aumenta."
    },
    "planets": {
      "intro": "Os Sigilos são símbolos planetários: cada conjunto leva o nome do efeito que dá e o símbolo de um planeta (Marte é Ataque, no sigilo e na ficha). Os efeitos de batalha têm símbolos próprios, na aba Efeitos.",
      "set": "Conjunto: {0}"
    },
    "effects": {
      "intro": "Efeitos duram turnos de quem os recebe. Os negativos passam pela Resistência do alvo menos a Precisão de quem lança (mínimo de {0}); a Imunidade barra todos. Na luta, o botão Efeitos mostra o que está sobre cada unidade.",
      "negative": "negativo",
      "positive": "positivo"
    },
    "runes": {
      "slots": { "title": "Espaços", "text": "Seis espaços em círculo. 1, 3 e 5 dão sempre Ataque, Defesa e Vida fixos; o 2 pode ter Velocidade, o 4 Crítico ou Dano crítico, o 6 Resistência ou Precisão, e os três podem ter Vida, Ataque ou Defesa, fixos ou em porcentagem sobre a base." },
      "stars": { "title": "Estrelas e raridade", "text": "De 1 a {0} estrelas: decidem o tamanho de todos os números. A cor é a raridade, quantos subatributos o sigilo tem: Normal 0, Mágico 1, Raro 2, Heroico 3, Lendário 4. Às vezes vem um atributo nativo, que nunca cresce." },
