    "basico": {
      "campanha": { "titulo": "Campanha", "texto": "20 fases com até 3 ondas; cada vitória custa Mana. A primeira vitória dá Pergaminhos e sempre uma runa; as seguintes dão Essência e chance de runa. A Campanha solta runas de até {0} estrelas." },
      "masmorras": { "titulo": "Masmorras", "texto": "Cada Masmorra tem 5 andares e solta o que a Campanha não solta: runas de 4 a 6 estrelas de quatro conjuntos certos, ou Pedras de Afiar e Gemas (a Forja). Cada vitória custa Mana; a primeira vitória em cada andar dá Ouro." },
      "mana": { "titulo": "Mana e nível da conta", "texto": "Toda vitória custa Mana; a derrota não custa nada, mas para lutar é preciso ter a Mana da vitória. A canalização recarrega {2} por hora até o máximo: {0} no nível 1 da conta, {1} no nível {3}, o máximo. Toda vitória dá experiência também à conta, e cada nível enche a Mana." },
      "ouro": { "titulo": "Ouro e Loja", "texto": "O Ouro é a moeda rara: vem da canalização, de cada nível da conta (+{0}) e da primeira vitória em cada andar de Masmorra. Na Loja, compra Mana (pode passar do máximo) ou Pergaminhos." },
      "invocacao": { "titulo": "Invocação", "texto": "Pergaminhos invocam monstros. Cada invocação é uma cópia nova, no nível 1. A primeira é uma 5★ garantida, e a garantia de 5★ está sempre à vista." },
      "monstros": { "titulo": "Monstros e Baú", "texto": "A coleção tem {0} vagas; o Baú guarda o que passar disso, sem limite. Monstro no Baú não luta, mas guarda as runas dele: elas não ocupam as {1} vagas do inventário de runas." },
      "equipes": { "titulo": "Equipes", "texto": "Uma equipe de até {0} monstros para a Campanha e uma para cada Masmorra. A primeira é a Líder." },
      "nivel": { "titulo": "Nível", "texto": "De 1 a {0}. Vitórias dão experiência à equipe que lutou; a Essência sobe o nível na hora, em Monstros. A mesma Essência paga o Despertar e a melhora de runas." },
      "ecos": { "titulo": "Ecos e Fragmentos", "texto": "Fundir uma cópia repetida dá +1 Eco (até {0}): cada Eco deixa as habilidades {1} mais fortes, e o último soma {2} aos atributos. As cópias que sobram podem ser liberadas em Fragmentos." },
      "despertar": { "titulo": "Despertar", "texto": "Paga Essência e o monstro ganha nome próprio, desenho novo, estrelas roxas, Assinatura melhorada, +{0} de Vida, +{1} de Ataque e Defesa e um bônus da variante: {2}, {3}, {4} ou {5}." }
    },
    "combate": {
      "impeto": { "titulo": "Ímpeto", "texto": "Cada unidade tem uma barra de {0} que enche em proporção à Velocidade; quem chega a 100% age. Empurrar ou atrasar a barra muda a ordem — a faixa \"Próximos\" mostra quem vem." },
      "eter": { "titulo": "Éter", "texto": "{0} é o recurso do time, de 0 a {1}. O básico não gera; cada habilidade especial gera {2} e cada inimigo derrubado, {3}. Ele paga as versões aprimoradas das habilidades (nenhuma custa menos de {4}): marque \"Aprimorar\" antes de escolher. Só no manual." },
      "luta": { "titulo": "A luta", "texto": "Até {0} monstros contra até {2} inimigos por onda, em até {1} ondas. Passar de {3} rodadas é derrota." },
      "dano": { "titulo": "Dano", "texto": "Ataque × multiplicador da habilidade × {0} / ({0} + Defesa do alvo). Defesa {0} corta o dano pela metade." },
      "critico": { "titulo": "Crítico", "texto": "O golpe crítico multiplica o dano por 1 + Dano crítico. Todo monstro começa com 15% de Crítico e 50% de Dano crítico." },
      "resistencia": { "titulo": "Resistência e Precisão", "texto": "Todo efeito negativo pode ser barrado: a chance é a Resistência do alvo menos a Precisão de quem lança, nunca abaixo de {0}." },
      "lider": { "titulo": "Líder", "texto": "A primeira da equipe aplica a Liderança dela a todos. A porcentagem é sobre o atributo de base, nunca sobre o que veio das runas." },
      "automatico": { "titulo": "Automático e Resolver", "texto": "O automático escolhe sozinho e nunca gasta {0}. Fases e andares já vencidos ganham o botão Resolver, que simula a luta na hora." },
      "elementos": "Elementos",
      "elementos_texto": "Com vantagem o dano sobe {0}; com desvantagem, cai {1}. O automático mira primeiro em quem ele vence.",
      "vence": "{0} vence {1}"
    },
    "atributos": {
      "intro": "Os oito atributos de todo monstro. Cada um tem o seu Glifo: o do conjunto de runas que o aumenta."
