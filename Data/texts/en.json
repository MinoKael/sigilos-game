  "compendium": {
    "tab": {
      "basic": "How to play",
      "combat": "Combat",
      "stats": "Stats",
      "glyphs": "Glyphs",
      "effects": "Effects",
      "runes": "Runes"
    },
    "basic": {
      "campaign": { "title": "Campaign", "text": "50 stages in three regions, with up to 3 waves; each victory costs Mana. The first victory gives Scrolls and always a rune; later ones give Essence and a chance of a rune. The Campaign introduces the game little by little: each part of the Sanctuary opens at a stage. It drops runes of up to {0} stars; beating stage 50 takes about level 20 with runes, or 6★ level 40 without." },
      "dungeons": { "title": "Dungeons", "text": "Each Dungeon has 5 floors, one element in most of its enemies, and drops what the Campaign doesn't: Rare or better runes from four specific sets, or Grindstones and Gems (the Forge). Every floor shows the chance of each star and rarity, and the deeper the floor, the bigger the runes: 2 and 3 stars on floor 1, only 6 stars on floor 5. Floor 1 is as hard in every Dungeon, and so on, as hard as what it pays. They open during the Campaign: Golem (Wind), Wyvern (Fire), Crypt (Dark), Drowned (Water) and the Forge (Light); bring the element with the advantage. Each victory costs Mana and may also drop a Mystic Scroll; the first victory on each floor gives Gold." },
      "exploration": { "title": "Star Exploration", "text": "A journey through the sky's 88 constellations: the Boreal ones, the Equatorial ones (with the 12 of the zodiac) and the Austral ones, one after another. Each constellation has its Influence, a mechanic that lasts the whole fight (read it first and build the team for it), and often the challenge is the guardian's skills, an awakened summon with every skill maxed. Each month, one of {0} explorations brings the challenges, in rotation, and on day 1 the journey starts over from scratch. Each constellation's reward is always the same and comes back every month, on its first victory: Essence, Gold, Scrolls and, at the milestones, Infusion Cores and special Scrolls. Fights cost no Mana, use their own team and are made for manual play." },
      "mana": { "title": "Mana and account level", "text": "Every victory costs Mana; a defeat costs nothing, but you need the victory's Mana to fight. Channeling refills {2} per hour up to twice the max Mana, which is {0} at account level 1 and {1} at level {3}, the last. Every victory also gives experience to the account, and each level refills Mana. At level {3}, a third of the experience becomes Essence." },
      "gold": { "title": "Gold and Shop", "text": "Gold is the rare currency: it comes from channeling, from every account level (+{0}) and from the first victory on each Dungeon floor. At the Shop it buys Mana (which can go past the maximum) or Scrolls." },
      "summon": { "title": "Summoning", "text": "Scrolls summon monsters. Every summon is a new copy, at its natural stars and level 1. The Mystic one brings Fire, Water and Wind, with the 5★ guarantee always on display; the Light and Dark one, only Light and Dark; the Legendary one, only 4★ and 5★. The two special ones come from game milestones. The account's first 5★ is guaranteed, and Fragments trade for a chosen 4★." },
      "monsters": { "title": "Monsters and Vault", "text": "The collection starts with {0} slots and grows in the Shop, with the Collection Expansion, up to {2}; the Vault keeps whatever goes past that, with no limit. A monster in the Vault doesn't fight, but keeps its runes: they don't take any of the {1} slots of the rune inventory. Lock a monster or a rune (the padlock) so it is never released, fused away or sold by mistake; unlock it to do so." },
      "teams": { "title": "Teams", "text": "A team of up to {0} monsters for the Campaign, one for each Dungeon and one for the Star Exploration. The first one is the Leader." },
      "level": { "title": "Level", "text": "Each star has its max level: {0} at 3★, up to {1} at 6★. Victories give experience to the team that fought; in Monsters, each Essence infused is worth {2} experience. The same Essence pays for evolution, Awakening and rune upgrades." },
      "stars": { "title": "Stars and evolution", "text": "Natural stars are only where a monster starts: every monster reaches {0}★. At max level, pay Fragments to gain a star: the monster keeps its level, its stats jump to the new star's and the max rises by 5. 3★ to 4★: {1} Fragments; 4★ to 5★: {2}; 5★ to 6★: {3}." },
      "skills": { "title": "Skills and copies", "text": "Each skill has levels: more damage, recovery or effect rate, or a shorter cooldown. Fusing a copy of the same family (any element) raises a random skill by one level. Leftover copies can be released into Fragments, which pay for evolution. Some monsters have a Passive, which acts on its own." },
      "awaken": { "title": "Awakening", "text": "Pay Essence ({0}, {1} or {2}, by natural stars) and the monster gets its own name, a living aura with the ring of its element, purple stars and higher HP, Attack and Defense (each monster has its own awakened stats: see the Grimoire), plus one bonus: a new skill (usually 3★), a stronger skill (usually 4★) or a stat (usually 5★: {3}, {4}, {5} or {6})." },
      "sanctuary": { "title": "Sanctuary and controls", "text": "The Sanctuary is the home screen. The Channeling gathers Essence, Gold and Mana while you are away, up to {0} hours: collect it there. Battle leads to the Campaign and the Dungeons; the bar at the bottom leads to Monsters, Runes, Teams, the Shop and the books. Touch a currency, a reward or a word you don't know to see what it is; hold a monster to see its summary." }
    },
    "combat": {
      "impetus": { "title": "Impetus", "text": "Each unit has a {0} bar that fills in proportion to Speed; whoever reaches 100% acts. Pushing or delaying the bar changes the order — the \"Next\" strip shows who is coming." },
      "fight": { "title": "The fight", "text": "Up to {0} monsters against up to {2} enemies per wave, in up to {1} waves. Going past {3} rounds is a defeat." },
      "damage": { "title": "Damage", "text": "Attack × skill multiplier × {0} / ({0} + target's Defense). {0} Defense halves the damage." },
      "crit": { "title": "Critical hits", "text": "A critical hit multiplies damage by 1 + Crit Damage. Every monster starts with 15% Crit Rate and 50% Crit Damage." },
      "resistance": { "title": "Resistance and Accuracy", "text": "Every harmful effect can be blocked: the chance is the target's Resistance minus the caster's Accuracy, never below {0}." },
      "leader": { "title": "Leader", "text": "The first one in the team applies its Leadership to everyone. The percentage is on the base stat, never on what came from runes." },
      "auto": { "title": "Auto and Auto Battle", "text": "Auto uses the strongest ready skill on its own. Stages and floors already beaten get the Auto Battle: you choose how many fights in a row ({0} to start), each taking the time it would on Auto at 2×. It keeps going while you do other things (tending runes, leveling monsters); the notice at the top of the screen shows the progress and opens its window. It stops when you press Stop, when Mana runs out or when the rune inventory fills up. Tap an enemy during a fight to mark it: Auto strikes it while it can (hold the enemy to see its summary). In a fight with a boss, the pause has \"Focus the boss on Auto\": on, the whole team strikes the boss whenever it can." },
      "elements": "Elements",
      "elements_text": "With advantage, damage goes up {0}; with disadvantage, it goes down {1}. Auto targets whoever it beats first.",
      "wins": "{0} beats {1}"
    },
    "stats": {
      "intro": "The eight stats of every monster. Each one has its Glyph: the one of the rune set that raises it."
    },
    "glyphs": {
      "intro": "Glyphs are rune symbols: each rune set has one, and the stat it raises shares it (Tiwaz is Attack on the rune and on the stat sheet). Battle effects have symbols of their own, in the Effects tab.",
      "set": "Set: {0}"
    },
    "effects": {
      "intro": "Effects last for the turns of whoever receives them. Harmful ones go through the target's Resistance minus the caster's Accuracy (minimum {0}); Immunity blocks them all. In a fight, the Effects button shows what is on each unit.",
      "negative": "harmful",
      "positive": "beneficial"
    },
    "runes": {
      "slots": { "title": "Slots", "text": "Six slots in a circle. 1, 3 and 5 always give flat Attack, Defense and HP; 2 can have Speed, 4 Crit Rate or Crit Damage, 6 Resistance or Accuracy, and all three can have HP, Attack or Defense, flat or as a percentage of the base." },
      "stars": { "title": "Stars and rarity", "text": "From 1 to {0} stars: they decide the size of every number. The color is the rarity, how many substats the rune has: Normal 0, Magic 1, Rare 2, Hero 3, Legendary 4. Sometimes it comes with an innate stat, which never grows." },
      "upgrade": { "title": "Upgrade", "text": "Essence upgrades from +0 to +{0} (the same Essence as levels and Awakening), and upgrades never fail. At +3, +6, +9 and +12 the rune needs 1, 2, 3 and {1} substats: if it doesn't have them yet, a new one is added (and its rarity goes up); if it does, one of them grows; at +15 the main stat makes its final jump." },
      "sets": { "title": "Sets", "text": "Two or four runes of the same set give its bonus. With 6 slots you fit one 4-piece and one 2-piece, or three 2-pieces (three of the same count three times). Each set has its Glyph." },
      "grind": { "title": "Grindstone", "text": "Adds a bonus to an HP, Attack, Defense or Speed substat of the same type as the stone. A new stone replaces the old bonus." },
      "gem": { "title": "Enchanted Gem", "text": "Swaps a substat of a +{0} rune for the gem's. Only one substat per rune can be enchanted." },
      "where": { "title": "Where to get them", "text": "The Campaign drops runes of up to {0} stars (always on the first victory, {1} chance afterwards). The Dungeons drop Rare or better runes from 2 to 6 stars, bigger on each floor, and the tools." },
      "grimoire": { "title": "Tables", "text": "The numbers for each star, the upgrade costs and the tool ranges are in the Grimoire." },
      "rarity": {
        "title": "Rune rarity",
        "text": "The rune's color shows its rarity: how many substats it is born with. The upgrades at +3, +6, +9 and +12 add the missing ones until there are four; a Legendary rune is born with all four, so each of those upgrades raises one of them.",
        "subs": "Born with {0} substats"
      }
    },
    "rarity": {
      "title": "Monster rarity",
      "text": "The card's frame shows its rarity: the natural stars the monster is born with. More natural stars mean a bigger stat budget and a rarer summon. The stars at the top of the card are the current ones (they go up by evolving); the frame never changes.",
      "frame2": "Faded frame",
      "frame3": "Bronze frame",
      "frame4": "Silver frame",
      "frame5": "Gold frame",
      "awakened": "Awakened: aura and purple stars"
    }
  },

