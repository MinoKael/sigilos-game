    "basic": {
      "campaign": { "title": "Campaign", "text": "20 stages with up to 3 waves; each victory costs Mana. The first victory gives Scrolls and always a rune; later ones give Essence and a chance of a rune. The Campaign drops runes of up to {0} stars." },
      "dungeons": { "title": "Dungeons", "text": "Each Dungeon has 5 floors and drops what the Campaign doesn't: 4 to 6 star runes from four specific sets, or Grindstones and Gems (the Forge). Each victory costs Mana; the first victory on each floor gives Gold." },
      "mana": { "title": "Mana and account level", "text": "Every victory costs Mana; a defeat costs nothing, but you need the victory's Mana to fight. Channeling refills {2} per hour up to the maximum: {0} at account level 1, {1} at level {3}, the maximum. Every victory also gives experience to the account, and each level refills Mana." },
      "gold": { "title": "Gold and Shop", "text": "Gold is the rare currency: it comes from channeling, from every account level (+{0}) and from the first victory on each Dungeon floor. At the Shop it buys Mana (which can go past the maximum) or Scrolls." },
      "summon": { "title": "Summoning", "text": "Scrolls summon monsters. Every summon is a new copy, at its natural stars and level 1. The first one is a guaranteed 5★, and the 5★ guarantee is always on display." },
      "monsters": { "title": "Monsters and Vault", "text": "The collection has {0} slots; the Vault keeps whatever goes past that, with no limit. A monster in the Vault doesn't fight, but keeps its runes: they don't take any of the {1} slots of the rune inventory." },
      "teams": { "title": "Teams", "text": "A team of up to {0} monsters for the Campaign and one for each Dungeon. The first one is the Leader." },
      "level": { "title": "Level", "text": "Each star has its max level: {0} at 3★, up to {1} at 6★. Victories give experience to the team that fought; in Monsters, each Essence infused is worth {2} experience. The same Essence pays for evolution, Awakening and rune upgrades." },
      "stars": { "title": "Stars and evolution", "text": "Natural stars are only where a monster starts: every monster reaches {0}★. At max level, pay Essence and Fragments to gain a star; the max rises by 5. 3★ to 4★: {1} Essence and {2} Fragments; 4★ to 5★: {3} and {4}; 5★ to 6★: {5} and {6}." },
      "skills": { "title": "Skills and copies", "text": "Each skill has levels: more damage, recovery or effect rate, or a shorter cooldown. Fusing a duplicate copy raises a random skill by one level. Leftover copies can be released into Fragments, which pay for evolution. Some monsters have a Passive, which acts on its own." },
      "awaken": { "title": "Awakening", "text": "Pay Essence ({0}, {1} or {2}, by natural stars) and the monster gets its own name, new art, purple stars, +{3} HP and +{4} Attack and Defense, plus one bonus: a new skill (usually 3★), a stronger skill (usually 4★) or a stat (usually 5★: {5}, {6}, {7} or {8})." },
      "sanctuary": { "title": "Sanctuary and symbols", "text": "Every button is a symbol: hover it to see its name. In the center of the Sanctuary, the channeling circle gathers Essence, Gold and Mana while you are away, up to {0} hours; touch it to collect. The stars around it are your shortcuts: the quill lets you choose them. The Map leads to the Campaign and the Dungeons; the Bag holds monsters, runes, teams, Summoning and the books." }
    },
    "combat": {
      "impetus": { "title": "Impetus", "text": "Each unit has a {0} bar that fills in proportion to Speed; whoever reaches 100% acts. Pushing or delaying the bar changes the order — the \"Next\" strip shows who is coming." },
      "fight": { "title": "The fight", "text": "Up to {0} monsters against up to {2} enemies per wave, in up to {1} waves. Going past {3} rounds is a defeat." },
      "damage": { "title": "Damage", "text": "Attack × skill multiplier × {0} / ({0} + target's Defense). {0} Defense halves the damage." },
      "crit": { "title": "Critical hits", "text": "A critical hit multiplies damage by 1 + Crit Damage. Every monster starts with 15% Crit Rate and 50% Crit Damage." },
      "resistance": { "title": "Resistance and Accuracy", "text": "Every harmful effect can be blocked: the chance is the target's Resistance minus the caster's Accuracy, never below {0}." },
      "leader": { "title": "Leader", "text": "The first one in the team applies its Leadership to everyone. The percentage is on the base stat, never on what came from runes." },
      "auto": { "title": "Auto and Resolve", "text": "Auto uses the strongest ready skill on its own. Stages and floors already cleared get Auto Battle: you choose how many fights in a row ({0} to start), each taking the time it would take on auto at 2×. It stops when Mana runs out or the rune inventory is full." },
      "elements": "Elements",
      "elements_text": "With advantage, damage goes up {0}; with disadvantage, it goes down {1}. Auto targets whoever it beats first.",
      "wins": "{0} beats {1}"
    },
    "stats": {
      "intro": "The eight stats of every monster. Each one has its Glyph: the one of the rune set that raises it."
    },
    "glyphs": {
      "intro": "Glyphs are rune symbols: each rune set has one, and the stat it raises shares it (Tiwaz is Attack on the rune and on the stat sheet). Battle effects have symbols of their own, in the Effects tab.",
      "set": "Set: {0}"
    },
    "effects": {
      "intro": "Effects last for the turns of whoever receives them. Harmful ones go through the target's Resistance minus the caster's Accuracy (minimum {0}); Immunity blocks them all. In a fight, the Effects button shows what is on each unit.",
      "negative": "harmful",
      "positive": "beneficial"
    },
    "runes": {
      "slots": { "title": "Slots", "text": "Six slots in a circle. 1, 3 and 5 always give flat Attack, Defense and HP; 2 can have Speed, 4 Crit Rate or Crit Damage, 6 Resistance or Accuracy, and all three can have HP, Attack or Defense, flat or as a percentage of the base." },
      "stars": { "title": "Stars and rarity", "text": "From 1 to {0} stars: they decide the size of every number. The color is the rarity, how many substats the rune has: Normal 0, Magic 1, Rare 2, Hero 3, Legendary 4. Sometimes it comes with an innate stat, which never grows." },
      "upgrade": { "title": "Upgrade", "text": "Essence upgrades from +0 to +{0} (the same Essence as levels and Awakening), and upgrades never fail. At +3, +6, +9 and +12 a new substat is added (up to {1}) or one of them grows; at +15 the main stat makes its final jump." },
      "sets": { "title": "Sets", "text": "Two or four runes of the same set give its bonus. With 6 slots you fit one 4-piece and one 2-piece, or three 2-pieces (three of the same count three times). Each set has its Glyph." },
      "grind": { "title": "Grindstone", "text": "Adds a bonus to an HP, Attack, Defense or Speed substat of the same type as the stone. A new stone replaces the old bonus." },
      "gem": { "title": "Enchanted Gem", "text": "Swaps a substat of a +{0} rune for the gem's. Only one substat per rune can be enchanted." },
      "where": { "title": "Where to get them", "text": "The Campaign drops runes of up to {0} stars (always on the first victory, {1} chance afterwards). The Dungeons drop the 5 and 6 star ones and the tools." },
      "grimoire": { "title": "Tables", "text": "The numbers for each star, the upgrade costs and the tool ranges are in the Grimoire." }
    }
  },

