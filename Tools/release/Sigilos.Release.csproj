<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publica uma versão do Windows para a atualização automática (docs/ATUALIZACOES.md).
    Compila por link o manifesto e o Updater do jogo: o formato do latest.json e a chave pública são os
    mesmos dos dois lados. Sigilos.csproj tem <Compile Remove="Tools\**" /> e a pasta tem .gdignore.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Sigilos.Release</AssemblyName>
    <RootNamespace>Sigilos.Release</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\GameEntry\Update\UpdateManifest.cs" LinkBase="Update" />
    <Compile Include="..\..\GameEntry\Update\Updater.cs" LinkBase="Update" />
  </ItemGroup>

</Project>
