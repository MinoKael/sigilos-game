<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gera a biblioteca de efeitos sonoros do jogo (docs/SONS.md): cada efeito é uma receita sintetizada do
    zero, sem nenhum arquivo de áudio de fora. Sigilos.csproj tem <Compile Remove="Tools\**" /> e a pasta
    tem .gdignore.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Sigilos.Sounds</AssemblyName>
    <RootNamespace>Sigilos.Sounds</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs;Synth/*.cs;Mastering/*.cs;Library/*.cs;Motifs/*.cs;Recipes/*.cs" />
  </ItemGroup>

</Project>
